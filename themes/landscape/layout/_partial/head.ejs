<head>
  <meta charset="utf-8">
  <%
  var title = page.title;
  if (is_archive()) { title = '文章归档'; if (is_month()) { title += ': ' + page.year + '/' + page.month; } else if (is_year()) { title += ': ' + page.year; } }
  else if (is_category()) { title = page.category; }
  %>
  <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <%- open_graph({twitter_id: theme.twitter, fb_admins: theme.fb_admins, fb_app_id: theme.fb_app_id}) %>
  <% if (config.feed) { %><%- feed_tag() %><% } else if (theme.rss) { %><%- feed_tag(theme.rss) %><% } %>
  <% if (theme.favicon) { %><%- favicon_tag(theme.favicon) %><% } %>
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>?v=20260905-images">
  <%- css('https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css') %>
</head>
